AMC_SITE=comics.example.org
PUBLIC_BASE_URL=https://comics.example.org
POSTGRES_PASSWORD=replace-with-a-random-password
# Use the same password here. URL-encode reserved characters in the connection URL.
DATABASE_URL=postgresql+asyncpg://amc:replace-with-a-random-password@db:5432/amc
JWT_SECRET=replace-with-a-long-random-secret
COMIC_ART_MODE=prepared
COMIC_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Daily comic generation limits (the provider is paid per comic; 0 = no limit).
COMIC_DAILY_TOTAL=300
COMIC_DAILY_PER_STUDENT=10
COMIC_DAILY_PER_TEACHER=40
COMIC_DAILY_PER_GUEST_IP=3
# Guests without an account cannot generate comics; set to 1 to allow it.
COMIC_GUESTS=0
# Comic panels drawn at the same time (same cost, shorter wait).
IMAGE_CONCURRENCY=3
# Parent purchases: test (no money moves, no provider yet) or off.
PAYMENTS_MODE=test
