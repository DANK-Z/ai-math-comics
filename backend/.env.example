# Copy to backend/.env; loaded by both API and worker. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Text model must support Chat Completions strict JSON Schema output.
OPENAI_TEXT_MODEL=gpt-6-luna
# Set empty to omit reasoning_effort for a model that does not support it.
OPENAI_TEXT_REASONING_EFFORT=none
# Image model must support generations AND reference-image edits with base64 PNG output.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
PROVIDER_TIMEOUT_SECONDS=180
JOB_TIMEOUT_SECONDS=1500
WORKER_POLL_SECONDS=1

# Shared by API and worker. Relative paths resolve against backend/, not the shell cwd.
# Stores comics.sqlite3 (including private answers) and images/. Never expose this whole dir.
COMIC_DATA_DIR=data
# Absolute externally reachable backend URL; used in generated panel imageUrl fields.
PUBLIC_BASE_URL=http://127.0.0.1:8000
